    { "unit": "unit-07", "from": "way",   "to": "gate", "match": "gate",
      "why": "hodos (road/way) and pylē (gate)" }
  ],

  "untag_word": [
    { "unit": "unit-01", "root": "save",  "match": "jesus",
      "why": "save = sōzō; 'Jesus' is a proper noun, not an occurrence of the verb" },
    { "unit": "unit-01", "root": "david", "match": "anointed",
      "why": "'Anointed' is christos, not David" },
    { "unit": "unit-01", "root": "dream", "match": "angel",
      "why": "dream = onar; 'angel of the Lord' is tracked separately if at all" },
    { "unit": "unit-02", "root": "dream", "match": "angel",
      "why": "same — onar only" },
    { "unit": "unit-06", "root": "release", "match": "false step",
      "why": "release = aphiēmi (the verb); paraptōma ('false steps') is its object" },
    { "unit": "unit-07", "root": "eye",   "nomatch": "eye",
      "why": "eye = ophthalmos only; drop the blepō renderings ('stare at', 'take it in', 'see clear through')" }
  ],

  "unwrap": [
    { "unit": "unit-01", "text": "deportation", "root": "beget",
      "why": "author slip — metoikesia is not the begetting verb" }
  ],

  "text": [
    { "unit": "unit-08", "from": "demonized", "to": "demon-possessed",
      "why": "'demonized' now reads as modern jargon" },
    { "unit": "unit-08", "from": "data-root=\"faith\">faith</span>", "to": "data-root=\"faith\">trust</span>",
